# List files or directories below to ignore them when running force:source:push, force:source:pull, and force:source:status
# More information: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_exclude_source.htm
#

package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# Directory placeholders — keep empty domain scaffolding tracked in git
# without letting the SFDX metadata resolver see it.
**/.gitkeep

# Markdown / docs folders are documentation, never deployable metadata.
# This also stops a stray .md dropped into a metadata folder from
# breaking a deploy.
**/docs/**
**/*.md
